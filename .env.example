DB_NAME=ticketsystem.db
BIND_ADDRESS=127.0.0.1:8080
DB_POOL_SIZE=4
SESSION_DURATION_HOURS=24
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_EMAIL=admin@localhost
ADMIN_DEFAULT_PASSWORD=changeme
PUBLIC_BASE_URL=http://127.0.0.1:8080
OAUTH_ACCESS_TOKEN_MINUTES=60
OAUTH_REFRESH_TOKEN_DAYS=30
# Optional HTTPS: set both to serve TLS directly (PEM files). Leave unset for plain HTTP.
# TLS_CERT_FILE=/etc/ticketsystem/cert.pem
# TLS_KEY_FILE=/etc/ticketsystem/key.pem
# Optional e-mail notifications (new/assigned tickets). Leave SMTP_HOST unset to disable.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls          # starttls (default) | tls (implicit, usually 465) | none (local relay only)
# SMTP_USERNAME=tickets@example.com
# SMTP_PASSWORD=secret
# SMTP_FROM=Ticketsystem <tickets@example.com>
# MAIL_LANG=de                    # language of the e-mails (en, de, es)
